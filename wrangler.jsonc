// Worker = 静态资产（out/）+ 一个轻量脚本（/api/contact 的 Turnstile 校验）。
// 未命中静态资产的请求才进脚本，其余由资产层直接返回。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myinfoweb",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // secret 通过 `wrangler secret put TURNSTILE_SECRET_KEY` 管理，不进仓库；
  // keep_vars 必须开着：默认 deploy 会删除配置外的 secret
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
