// Worker = 静态资产（out/）+ 一个轻量脚本（/api/contact 的 Turnstile 校验）。
// 未命中静态资产的请求才进脚本，其余由资产层直接返回。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myinfoweb",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // 测试项目：secret 直接走明文 vars（仓库公开可见）。正式化时在 Turnstile 控制台轮换 secret，
  // 改用 `wrangler secret put TURNSTILE_SECRET_KEY` 并从此处移除明文
  "vars": {
    "TURNSTILE_SECRET_KEY": "0x4AAAAAAFOx-3PEHJok4RdYO7f2NDXFKDI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
