// Worker = 静态资产（out/）+ 一个轻量脚本（/api/contact 的 Turnstile 校验）。
// 未命中静态资产的请求才进脚本，其余由资产层直接返回。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myinfoweb",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // secret 通过 `wrangler secret put TURNSTILE_SECRET_KEY` 管理，不进仓库；
  // keep_vars 必须开着：默认 deploy 会删除配置外的 secret
  "keep_vars": true,
  // www 子域同样走这个 Worker：此前 www 只有被代理的 DNS 记录、没有 worker 绑定，
  // 请求回源超时返回 522；主域 apex 用的是控制台里的 Custom Domain，不受影响。
  "routes": [{ "pattern": "www.mingyanginfo.com/*", "zone_name": "mingyanginfo.com" }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "MESSAGES_DB",
      "database_name": "mingyang-messages",
      "database_id": "74694923-0004-4b66-8607-12e34f2f3676"
    }
  ]
}
